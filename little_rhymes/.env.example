# LOCAL DEVELOPMENT: copy to .env. Never commit .env.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Empty locally = SQLite. Production requires PostgreSQL and Redis.
DATABASE_URL=
DATABASE_SSL_REQUIRE=False
REDIS_URL=
USE_S3=False

# PRODUCTION: DEBUG=False, random SECRET_KEY >=50 chars (or Render-generated 256-bit base64 seed), HTTPS SITE_URL,
# DATABASE_SSL_REQUIRE=True, USE_S3=True, real values below, Redis URL,
# explicit ALLOWED_HOSTS and matching HTTPS CSRF_TRUSTED_ORIGINS.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Exact HTTPS origins where images/audio/video are loaded, comma-separated.
MEDIA_ORIGINS=
# Optional exact hosts for directly hosted MP4/WebM videos (no scheme).
EXTERNAL_VIDEO_HOSTS=
# Set only on Render behind its managed proxy.
TRUST_RENDER_PROXY=False
HSTS_INCLUDE_SUBDOMAINS=False
HSTS_PRELOAD=False
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
LOG_LEVEL=INFO
